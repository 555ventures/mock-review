{
  "name": "@555/mock-review",
  "version": "1.0.0",
  "description": "The mock reviewer CLI and page for the spec pipeline's mock app (contract v1).",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "bin": {
    "mock-review": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js && vite build -c vite.page.config.ts && mkdir -p dist/frame && cp src/frame/entry.tsx dist/frame/entry.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "check": "npm run typecheck && npm run lint && npm run test",
    "release:check": "node scripts/release-check.mjs"
  },
  "peerDependencies": {
    "playwright": "^1.63.0",
    "react": "^19",
    "react-dom": "^19",
    "vite": "^8"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "dependencies": {
    "react-docgen-typescript": "^2.4.0",
    "typescript": "~6.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "eslint": "^10.10.0",
    "lucide-react": "^1.46.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.12.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
