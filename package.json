{
  "name": "@555-ventures/mock-review",
  "version": "3.1.0",
  "description": "The mock reviewer CLI and page for the spec pipeline's mock app (contract v3).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/555ventures/mock-review.git"
  },
  "private": false,
  "type": "module",
  "bin": {
    "mock-review": "dist/cli.js"
  },
  "files": [
    "dist",
    "src/ui",
    "src/schemas/version.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "login": "npm login --auth-type=web",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:push": "node scripts/db-push.mjs",
    "walkthrough": "vite --config vite.walkthrough.config.ts --configLoader runner",
    "prove:server": "node scripts/prove-server.mjs"
  },
  "peerDependencies": {
    "playwright": "^1.63.0",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4",
    "vite": "^8"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@json-render/core": "^0.21.0",
    "@json-render/react": "^0.21.0",
    "@types/pg": "^8.23.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.46.0",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react-docgen-typescript": "^2.4.0",
    "react-resizable-panels": "^4.12.4",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
